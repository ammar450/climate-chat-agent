# LLM Backend Configuration
# Choose backend: openai | ollama
LLM_BACKEND=openai

# OpenAI Configuration
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Ollama Configuration (local LLM — no API key needed)
# Use host.docker.internal so Docker can reach Ollama on your host machine.
# Works on: Windows & Mac (Docker Desktop) automatically.
# Works on: Linux — requires Docker Compose (extra_hosts is already configured).
# For plain `docker run` on Linux add: --add-host=host.docker.internal:host-gateway
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

# Legacy LLM Provider Configuration (for llm_client.py compatibility)
LLM_PROVIDER=openai

# LLM Parameters
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1000
LLM_TIMEOUT=30

# RAG Configuration
USE_RAG=true
ENABLE_FAST_MODE=false

# SPARQL Endpoint Configuration
# Primary knowledge source: EOBS — always queried first
# Full dataset: 1950-2024
SPARQL_ENDPOINT=https://obs.knowledgehub.nfdi4earth.de/sparql/
GRAPH_IRI=http://eobs/gridded

# Wikidata endpoint — used ONLY for enrichment (labels, geographic context)
# Never replaces or overrides EOBS data
WIKIDATA_ENDPOINT=https://query.wikidata.org/sparql
WIKIDATA_TIMEOUT=10

# Query Safety Limits
MAX_LIMIT=500
DEFAULT_LIMIT=200
SPARQL_TIMEOUT=30

# Caching Configuration (in minutes)
CACHE_TTL_MINUTES=15

# Rate Limiting (requests per minute per session)
MAX_REQUESTS_PER_MINUTE=30

# Server Configuration
PORT=8000
HOST=0.0.0.0

# Redis (optional - falls back to in-memory if not available)
# REDIS_URL=redis://localhost:6379/0
