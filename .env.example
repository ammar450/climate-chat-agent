# LLM Backend Configuration
# Choose backend: openai | ollama
LLM_BACKEND=openai

# OpenAI Configuration (Default)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Ollama Configuration (local LLM via Ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Legacy LLM Provider Configuration (for llm_client.py compatibility)
LLM_PROVIDER=openai

# LLM Parameters
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1000
LLM_TIMEOUT=30

# SPARQL Endpoint Configuration
SPARQL_ENDPOINT=https://hyobs.bgc-jena.mpg.de/sparql
GRAPH_IRI=http://hyobs.nfdi4earth.de/graph/climateobservations

# Optional: Redis for session management
# REDIS_URL=redis://localhost:6379/0
